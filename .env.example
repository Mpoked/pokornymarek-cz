# ── Studio Dva — konfigurace ──────────────────────────────────────
# Zkopíruj tento soubor jako .env.local a doplň hodnoty.
# .env.local je v .gitignore — hesla se nikdy necommitují.

# Heslo do administrace na /admin
ADMIN_PASSWORD=zmen-me-na-silne-heslo

# ── SMTP pro e-mailová upozornění na nové poptávky ────────────────
# Doporučeno: Gmail s heslem aplikace.
# Návod: 1) zapni dvoufázové ověření na https://myaccount.google.com/security
#        2) vygeneruj heslo aplikace na https://myaccount.google.com/apppasswords
#        3) vlož ho (16 znaků bez mezer) do SMTP_PASS
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=pokornymarek007@gmail.com
SMTP_PASS=

# Kam mají chodit upozornění (více adres odděl čárkou)
CONTACT_TO=pokornymarek007@gmail.com

# ── Databáze ──────────────────────────────────────────────────────
# Cesta k SQLite souboru. Bez nastavení: ./data/studio.db
# V Dockeru se nastavuje na /app/data/studio.db (viz docker-compose.yml)
# DB_PATH=./data/studio.db
