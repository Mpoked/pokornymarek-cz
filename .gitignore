# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# systémové smetí (Windows / macOS)
Thumbs.db
ehthumbs.db
desktop.ini

# dočasné a zálohy
*.tmp
*.temp
*.bak
*.log

# IDE
/.vs/
/.idea/
*.suo
*.user

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# databaze poptavek (SQLite) - data zustavaji jen na serveru
/data

# lokální tooling (Claude, codegraph) a demo projekty — nepatří do repa webu
/.claude/
/.agents/
/.codegraph/
/projekty/
/skills-lock.json

# lokální spouštěcí skripty s absolutními cestami
/run.cmd
/vystup.log
